{
    "name": "express-api-template",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.12"
    },
    "scripts": {
        "dev": "node --watch src/server.js",
        "start": "node src/server.js",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "migrate": "knex migrate:latest",
        "migrate:make": "knex migrate:make",
        "migrate:rollback": "knex migrate:rollback",
        "new:feature": "node scripts/new-feature.mjs"
    },
    "dependencies": {
        "better-sqlite3": "^13.2.0",
        "cors": "^2.8.6",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.5",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.3.0",
        "mongoose": "^9.12.3",
        "morgan": "^1.12.1",
        "multer": "^2.5.0",
        "nodemailer": "^10.6.1",
        "pg": "^8.23.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "mongodb-memory-server": "^11.4.0",
        "supertest": "^7.3.2",
        "vitest": "^5.1.1"
    }
}
