# Copy to .env for local development:
#
#   cp .env.example .env
#
# .env is gitignored - it holds a signing key and a database password. In a container and
# in CI these are real environment variables, which always win over the file.

NODE_ENV=development
PORT=5000
APP_NAME=express-api-template

# Where the web app lives - the password-reset link is built from it.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------- database
# DB_CLIENT picks the database; DATABASE_URL says where it is.
#
#   sqlite   DATABASE_URL=./data/dev.sqlite                         a file, nothing to install
#   mongo    DATABASE_URL=memory                                    a throwaway in-process MongoDB (development only)
#            DATABASE_URL=mongodb://localhost:27017/my_app          a local server, or an Atlas mongodb+srv:// URI
#   pg       DATABASE_URL=postgres://user:password@localhost:5432/my_app
#   mysql    DATABASE_URL=mysql://user:password@localhost:3306/my_app          (npm install mysql2)
#   mssql    DATABASE_URL=mssql://sa:password@localhost:1433/my_app            (npm install tedious)
DB_CLIENT=sqlite
DATABASE_URL=./data/dev.sqlite

# Apply migrations (SQL) / build indexes (MongoDB) when the app starts. Default: on in
# development, off in production.
# RUN_MIGRATIONS_ON_STARTUP=true

# Insert the demo accounts and items. Default: on in development; ignored in production
# unless KEEP_DEMO_LOGINS=true.
# SEED_DEMO_DATA=true

# ---------------------------------------------------------------- tokens
# Signs every token. At least 32 characters; the app refuses to start without it.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_ISSUER=express-api-template
JWT_AUDIENCE=express-api-template-client
JWT_EXPIRY_DAYS=7

# ---------------------------------------------------------------- production only
# Behind nginx or another reverse proxy.
# BEHIND_REVERSE_PROXY=true

# A production start closes the demo accounts and needs one administrator. When none
# exists, this account is created with this password. Remove it after the first login.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=

# A demo stack that runs as production and should keep the demo logins. Never on a real deployment.
# KEEP_DEMO_LOGINS=true

# ---------------------------------------------------------------- files
# "local" writes under UPLOADS_DIR. "s3" uses the S3-compatible settings below (MinIO
# locally, Cloudflare R2 or S3 in production) and needs: npm install @aws-sdk/client-s3
STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=app-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.your-domain.com
# S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- e-mail
# Leave SMTP_HOST empty to send nothing: a password-reset request is then logged as
# undeliverable and the caller is told the same thing either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=
